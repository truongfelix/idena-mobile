<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Hearing the router's own UPnP announcements, for the router port (some routers never answer a search). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- allowBackup=false: the node key must not be copied to a cloud or device-transfer backup. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.IdenaNode">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The practice validation. Portrait only, and no restart on a rotation or a dark mode switch,
             which would lose the session. -->
        <activity
            android:name=".CeremonyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- The validation ceremony, likewise kept through rotations and theme switches. -->
        <activity
            android:name=".ValidationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Making a flip. Portrait, kept through rotations and theme switches (the camera may rotate). -->
        <activity
            android:name=".FlipActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- The account's history: ceremonies, transactions, mining. -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- The oracle votings of the identity's committees, and the vote. -->
        <activity
            android:name=".OracleVotingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- My ads: drafts, their review votings, showing them. -->
        <activity
            android:name=".MyAdsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- Where the camera app writes the photo taken for a flip picture. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/flip_camera_paths" />
        </provider>

        <!-- The node runs in a process of its own: stopping it ends that process, as the desktop
             app ends the node process, and a new start gets a fresh process. -->
        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":node">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs an Idena blockchain node that keeps syncing while the user has sync switched on" />
        </service>

        <!-- The node's watchdog restarts it from the app's main process (NodeWatch.kt). -->
        <receiver
            android:name=".NodeRestartReceiver"
            android:exported="false" />
    </application>
</manifest>
